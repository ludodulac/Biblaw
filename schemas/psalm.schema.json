{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biblaw.local/schemas/psalm.schema.json",
  "title": "Biblaw Psalm",
  "type": "object",
  "required": ["id", "recordType", "archangel", "book", "number", "title", "source", "verses", "validation"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z]+-psalm-[0-9]{3}$" },
    "recordType": { "const": "psalm" },
    "archangel": { "enum": ["michael", "raphael", "gabriel", "ouriel"] },
    "book": {
      "type": "object",
      "required": ["number", "title"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "number": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "source": { "type": "object" },
    "verses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "text", "sourcePages"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "text": { "type": "string", "minLength": 1 },
          "sourcePages": { "type": "array", "items": { "type": "integer" } },
          "speakerId": { "type": "string" },
          "speechRole": { "enum": ["teaching", "question", "answer", "invocation", "editorial-unknown"] }
        }
      }
    },
    "notes": { "type": "array" },
    "noteIds": { "type": "array", "items": { "type": "string" } },
    "masterPrayer": { "type": ["object", "null"] },
    "prayerIds": { "type": "array", "items": { "type": "string" } },
    "contextIds": { "type": "array", "items": { "type": "string" } },
    "temporalMentions": { "type": "array" },
    "conceptIds": { "type": "array", "items": { "type": "string" } },
    "validation": { "type": "object" }
  }
}
