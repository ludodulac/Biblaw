{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biblaw.local/schemas/selection.schema.json",
  "title": "Biblaw export selection",
  "type": "object",
  "required": ["id", "items", "output"],
  "properties": {
    "id": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recordId", "include"],
        "properties": {
          "recordId": { "type": "string" },
          "include": { "enum": ["record", "selected-verses", "psalm-with-prayer"] },
          "verseNumbers": { "type": "array", "items": { "type": "integer" } }
        }
      }
    },
    "sourceTypeFilters": {
      "type": "array",
      "items": { "enum": ["psalm", "prayer", "note", "introduction", "annex", "other"] }
    },
    "output": {
      "type": "object",
      "required": ["format"],
      "properties": {
        "format": { "enum": ["screen", "print", "text", "json", "pdf"] },
        "includeSourceReferences": { "type": "boolean" }
      }
    }
  }
}
